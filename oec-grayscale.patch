+int oec_image_to_rgb(
+    const OecImage *source,
+    OecImage *destination)
+{
+    size_t pixels;
+    size_t i;
+    size_t stride;
+
+    if (source == NULL ||
+        destination == NULL ||
+        source->data == NULL)
+        return -1;
+
+    if (source->width <= 0 ||
+        source->height <= 0 ||
+        source->channels <= 0)
+        return -1;
+
+    if (oec_image_create(
+            destination,
+            source->width,
+            source->height,
+            3) != 0)
+        return -1;
+
+    pixels =
+        (size_t)source->width *
+        (size_t)source->height;
+
+    stride = (size_t)source->channels;
+
+    for (i = 0; i < pixels; i++) {
+        const float *src = &source->data[i * stride];
+        float *dst = &destination->data[i * 3];
+
+        if (source->channels >= 3) {
+            dst[0] = src[0];
+            dst[1] = src[1];
+            dst[2] = src[2];
+        } else {
+            dst[0] = src[0];
+            dst[1] = src[0];
+            dst[2] = src[0];
+        }
+    }
+
+    return 0;
+}
+
